<% content_for :title, "#{current_user.name}さんの投稿一覧" %>

<h1 class="text-center text-5xl my-20 font-mono"><%= "#{current_user.name}さんの投稿一覧" %></h1>

<% if logged_in? %>
<turbo-frame id="tab-content">
  <%= render "shared/board", content_lists: @content_lists %>
</turbo-frame>
<% end %>

<div class="flex flex-col justify-center  p-4 px-5  bg-green-200/90 rounded-md">
<%= link_to "コンテンツ一覧", content_lists_path, class: "flex flex-col justify-center  p-4 px-5  bg-green-200/90 rounded-md" %>
</div>

