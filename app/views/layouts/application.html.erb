<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag 'ゴリゴリ テキスト屋さん.png' %>
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
    <%= display_meta_tags(default_meta_tags) %>
    </head>

  <body class="bg-[url('https://img.freepik.com/free-vector/simple-green-gradient-background-vector-for-business_53876-175740.jpg?w=740&t=st=1725635454~exp=1725636054~hmac=7bac11f49c89238720f6b460da1d95fa4efedbc4ce42110e453497a39716d53b')] bg-cover bg-center bg-fixed min-h-screen">
  <%= render "shard/navigation" %>
  <p class="px-6 bg-green-200">
    <%= notice %>
  </p>
  <%= yield %>    
  </body>
  
  
</html>
