<!-- shared/_toggle_button.html.erb -->
<div class="text-center">
    <% if show_more %>
      <%= button_to 'もっと見る', show_all_content_lists_path, method: :get, remote: true, class: 'bg-blue-500 text-white px-4 py-2 rounded mt-4', id: 'toggle-btn' %>
    <% else %>
      <%= button_to '閉じる', content_lists_path, method: :get, remote: true, class: 'bg-red-500 text-white px-4 py-2 rounded mt-4', id: 'toggle-btn' %>
    <% end %>
  </div>
  