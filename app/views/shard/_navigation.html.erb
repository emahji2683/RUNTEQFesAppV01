<div class="bg-green-500 bg-opacity-100 p-2 relative z-20">
<% if logged_in? %>
  <div class="text-gray-100 p-4 flex z-20 bg-opacity-400 justify-between">
    <%= link_to "ログアウト", logout_path, class: "text-gray-100 z-20 bg-opacity-400", data: { turbo_method: :delete, turbo_confirm: "本当にログアウトしますか？" } %>
    <p class="text-right ml-auto"><%= "#{current_user.name}様ようこそ" %></p>
  </div>

<% else %>
  <%= link_to "ログイン", login_path, class: "text-2xl text-gray-100" %>
  <%= link_to "新規登録", signup_path, class: "text-2xl text-gray-100" %>
<% end %>
</div>