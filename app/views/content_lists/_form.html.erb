<%= form_with(model: content_list, local: true) do |form| %>
  <% if content_list.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(content_list.errors.count, "error") %> prohibited this content_list from being saved:</h2>

      <ul >
        <% content_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div class=" mb-5">
    <%= form.label :title,class:"text-red-700 bg-green-40", style: "display: block" %>
    <%= form.text_field :title,class:"border-2 focus:border-blue-500 w-80 h-10 focus:outline-none" %>
  </div>

  <div class=" mb-5">
    <%= form.label :repeat_content, style: "display: block" %>
    <%= form.text_field :repeat_content,class:"border-2 focus:border-blue-500 w-80 h-10 focus:outline-none" %>
  </div>

  <div class="">
    <%= form.label :repeat_times, style: "display: block" %>
    <%= form.number_field :repeat_times,class:"border-2 focus:border-blue-500 w-80 h-10 focus:outline-none" %>
  </div>

  <div>
    <%= form.submit "Submit", class: "mt-3 bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" %>

  </div>
<% end %>
