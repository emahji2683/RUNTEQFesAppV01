<div class="my-20 bg-yellow-200 inline-block p-5 rounded-lg relative  md:w-1/2 w-[80%] max-w-[1000px]"> 

  <% if content_list.errors.any? %>
  <div class="absolute bg-yellow-200 p-6 rounded-md shadow-lg -top-40 -right-20 transform -rotate-6 w-64 max-w-md">
    <ul class="text-red-700">
      <% content_list.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
  <% end %>


  <%= form_with(model: content_list, local: true) do |form| %>
    <div class="flex flex-col px-5 ">
      <div class=" mb-5 ">
        <%= form.label :title, "タイトル", class: "text-left block text-red-700 md:text-xl lg:text-2xl" %>
        <%= form.text_field :title, class: " bg-yellow-200 border-b-4 border-red-500 focus:border-blue-500 w-full h-10 focus:outline-none" %>
      </div>
  
      <div class="mb-5 ">
        <%= form.label :repeat_content, "繰り返すもの", class: "text-left block  md:text-xl lg:text-2xl" %>
        <%= form.text_field :repeat_content, class: "bg-yellow-200 border-b-4 border-red-500 focus:border-blue-500 w-full h-10 focus:outline-none" %>
      </div>
  
      <div class="">
        <%= form.label :repeat_times, "繰り返す回数", class: "text-left block  md:text-xl lg:text-2xl" %>
        <%= form.number_field :repeat_times, class: "bg-yellow-200 border-b-4 border-red-500 focus:border-blue-500 w-full h-10 focus:outline-none" %>
      </div>
  
    <div class="mt-4 text-center ">
      <%= form.submit "つくる", class: "btn-pen cursor-pointer hover:bg-[#fca5a5]" %>
    </div>

  <% end %>
</div>