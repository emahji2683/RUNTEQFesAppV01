
<p class="xl text-center text-6xl my-8">
  <%= @content_list.title %>
</p>

<div class=" relative flex justify-center ">
  <div style="z-index: -1;" class="md:text-xl lg:text-2xl lx:3xl  absolute  w-[95%] max-w-full break-words opacity-50  border  bg-gray-700 text-white ">
      <div id="content">
        <% @chunks.each do |chunk| %>
          <div class="m-2 chunk text-center">
            <%= chunk.html_safe %>
          </div>
        <% end %>
      </div>
    </div>

</div>

<div class="fixed inset-0 flex items-center justify-center">
  <div class="p-10 rounded-lg bg-pink-100/50 border-8 border-white">
    <button id="download" class="px-6 py-2 my-8 text-3xl bg-green-500/50 text-white rounded-3xl flex items-center justify-center"><span class="material-symbols-outlined">
      download
      </span>テキストファイルをダウンロード</button>

    <div class=" flex flex-col justify-center  p-4 px-5  bg-green-200/90 rounded-md ">
      <h1 class="text-2xl py-3 ">音声でも繰り返してみる</h1>

      <input class="mb-2 p-2 border bounded" type="text" id="text-to-speech" value="<%= @repeat_string_forsound %>" readonly>

      <!-- 再生ボタンだよー -->
      <div class="flex justify-center space-x-12">
        <div class="flex flex-col items-center">
          <button onclick="speakText(document.getElementById('text-to-speech').value)" span class="w-12 h-12 flex flex-col items-center justify-center my-2 bg-blue-500 text-white rounded-full hover:bg-blue-600 hover:shadow-sm hover:translate-y-0.5 transform transition">
            <span class="material-symbols-outlined text-6xl text-black">
              play_circle
            </span>
          </button>
          <span class="text-sm text-center -mt-2">さいせい</span>
        </div>

        <!-- 停止ぼたん -->
        <div class="flex flex-col items-center">
          <button onclick="stopSpeech()" class="w-12 h-12 my-2 bg-red-500 hover:bg-red-600 rounded-full hover:shadow-sm hover:translate-y-0.5 transform transition text-white rounded flex items-center justify-center"><span class="material-symbols-outlined text-6xl text-black">
            stop_circle
            </span>
          </button>
          <span class="text-sm text-center -mt-2">ていし</span>
        </div>
      </div>

      <hr class="border-t-2 border-dashed border-gray-400"> <!-- てんせん -->        

      <div class="flex justify-center space-x-12">
      <button onclick="copyUrlTitle()" class="my-2 bg-green-500/50   hover:bg-green-600 text-white rounded  flex items-center justify-center"><span class="material-symbols-outlined">
          content_copy
          </span>URLをコピー</button>

      <div class="flex justify-center"> <!-- Flexコンテナで中央揃え -->
      <%= link_to "https://twitter.com/share?url=#{request.url}&text=【RUNTEQ祭アプリ】%0a#{@content_list.title}を超絶繰り返しました",
                   target: '_blank',
                   class: "my-2 bg-pink-400/50 text-white rounded hover:text-blue-700 flex items-center justify-center" do %>

        <img src="<%= asset_path('logo-black.png') %>" alt="X(旧twitterアイコン)" class="w-4 h-4" />
        <span>ひけらかす</span>
      <% end %>
    </div>

    </div>

    <div class="bg-red-50 px-10 mt-5">
      <div class="flex justify-center space-x-12">
        <!-- へんしゅうぼたーん -->
        <%= link_to edit_content_list_path(@content_list),class:"bg-pink-400 rounded hover:text-blue-700 flex items-center space-x-1 px-2 py-1" do %>
          <span class="material-symbols-outlined text-white">
            edit
          </span>
          <span>へんしゅう</span>
        <% end %>

        <!-- しょきょぼたーん -->
        <%= button_to content_list_path(@content_list), class: "bg-pink-400 rounded hover:text-blue-700 flex items-center space-x-1 px-2 py-1", method: :delete do %>
          <span class="material-symbols-outlined text-white">
            ink_eraser
          </span>
          <span>しょうきょ</span>
        <% end %>        
          </div>
          <%= render "shared/button",text:"コンテンツ一覧",path: content_lists_path  %>
    </div>
  </div>
</div>

<script>
document.getElementById("download").addEventListener("click", function() {
  const text = "<%= j @repeat_string %>";
  const blob = new Blob([text], {type: "text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "<%= j @content_list.title %>.txt";
  a.click();
  URL.revokeObjectURL(url);
});
</script>