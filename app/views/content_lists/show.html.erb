<p style="color: green"><%= notice %></p>

<p class="xl"><%= @content_list.title %></p>
<div class="max-w break-words border border-black p-2">
  <link_to class="responsive-text break-words"><%= @repeat_string %></a>
</div>

<div>
  <%= link_to "Edit this content list", edit_content_list_path(@content_list) %> |
  <%= link_to "Back to content lists", content_lists_path %>

  <%= button_to "Destroy this content list", @content_list, method: :delete %>
</div>
<button id="download">テキストファイルをダウンロード</button>

<h1>音声合成デモ</h1>

<input type="text" id="text-to-speech" placeholder="><%= @content_list.title %>">
<button onclick="speakText(document.getElementById('text-to-speech').value)">音声を再生</button>

<br>

<button onclick="playSound()">サウンドを再生</button>

<div>
<button onclick="copyUrlTitle()">URLをコピー</button>
</div>

<%= link_to "https://twitter.com/share?url=#{ request.url }&text=【RUNTEQ祭アプリ】%0a#{ @content_list.title }を超絶繰り返しました", target: '_blank' do %>
  <i class="fab fa-twitter" style='color: #3399FF;'></i>何回も呟いた努力の結晶を人にひけらかす
<% end %>

<script>
document.getElementById("download").addEventListener("click", function() {
  const text = "<%= j @repeat_string %>";
  const blob = new Blob([text], {type: "text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "<%= j @content_list.title %>.txt";
  a.click();
  URL.revokeObjectURL(url);
});
</script>
