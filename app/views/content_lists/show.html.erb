<p style="color: green">
  <%= notice %>
</p>

<p class="xl text-center text-6xl my-8">
  <%= @content_list.title %>
</p>
<div class="relative">
  <div style="z-index: -1;" class="absolute z- opacity-50 mx-4  max-w break-words border  p-2 bg-gray-700 text-white ">
    <link_to class="responsive-text break-words ">
      <%= @repeat_string %></a>
  </div>
</div>
<div class="text-center my-10 flex flex-col items-center">
  <div class="p-10 rounded-lg bg-pink-100/50 border-8 border-white">
    <button id="download" class="px-6 py-2 my-8 text-3xl bg-green-500/50 text-white rounded-3xl ">テキストファイルをダウンロード</button>
  
    <div class=" flex flex-col justify-center  p-4 px-5  bg-green-200/90 rounded-md ">
      <h1 class="text-2xl py-3 ">音声合成デモ</h1>
  
      <input class="mb-2 p-2 border bounded" type="text" id="text-to-speech" value="<%= @repeat_string_forsound %>" readonly>
      <button onclick="speakText(document.getElementById('text-to-speech').value)" class="my-2 bg-blue-500 text-white rounded hover:bg-blue-600">音声を再生</button>
      <button onclick="stopSpeech()" class="my-2 bg-pink-400/50  text-white rounded hover:bg-pink-500">音声をストップ</button>      
      <button onclick="copyUrlTitle()" class="my-2 bg-pink-400/50 text-white rounded hover:text-blue-700">URLをコピー</button>
    
      <%= link_to "https://twitter.com/share?url=#{ request.url }&text=【RUNTEQ祭アプリ】%0a#{ @content_list.title }を超絶繰り返しました", target: '_blank',class:"my-2 bg-pink-400/50 text-white rounded hover:text-blue-700" do %>
        <i style='color: #3399FF;'></i>何回も呟いた努力の結晶を人にひけらかす
      <% end %>
    </div>
  
    <div class="bg-red-50 px-10 mt-5">
      <%= link_to "Edit this content list" , edit_content_list_path(@content_list),class:"hover:text-blue-700 " %> |
        <%= link_to "Back to content lists" , content_lists_path,class:"hover:text-blue-700" %>
  
          <%= button_to "Destroy this content list" , @content_list, method: :delete,class:"hover:text-blue-700" %>
    </div>
  </div>
</div>


<script>
document.getElementById("download").addEventListener("click", function() {
  const text = "<%= j @repeat_string %>";
  const blob = new Blob([text], {type: "text/plain"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "<%= j @content_list.title %>.txt";
  a.click();
  URL.revokeObjectURL(url);
});
</script>