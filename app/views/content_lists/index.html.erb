<% content_for :title, "ゴリゴリテキスト屋さん" %>
<div class= "text-center flex items-center justify-center">
<%= image_tag "ゴリゴリ_テキスト屋さん_1.png", width: "1400"%>
</div>
<% if logged_in? %>
<turbo-frame id="tab-content">
  <%= render "shared/board" , content_lists: @content_lists.limit(6) %>
</turbo-frame>
<% end %>

<!-- トグルボタン -->
<% if @content_lists.size > 6 %>
  <turbo-frame id="toggle-button-frame">
    <div class="text-center">
     <%= render "shared/toggle_button",show_more:true  %>
    </div>
  </turbo-frame>
<% end %>

<div class="bg-red-400 text-white my-10 text-center mx-3 ">
 <h2 class="text-2xl py-3">使い方</h2>
 
 <p class="py-8">このアプリにたどり着いた血迷った貴様に繰り返しの極意を授けよう</p>
 <p class="">極意①：好きな言葉をテキストとして出力できるんダナ</p>
 <p class="">極意②：好きな言葉を繰り返した結果を結果ページに出力できるんダナ</p>
 <p class="">極意③：好きな言葉を繰り返したページをURL、Xでみんなに共有出来るんダナ</p>
 <p class="">極意④：好きな言葉をくり返しし音声でも楽しめるんダナ</p>

 <p class="">【作成方法】</p>
 <p class="">①新たに繰り返すを押す</p>
 <p class="">②ボード名、繰り返したい文字列、その回数を入力(1,000,000万回上限)</p>
 <p class="">③提出を押すと繰り返し画面に遷移</p>
 <p class="">↓！繰り返し結果を閲覧、ダウンロード、共有できる！↓</p>

 <div>
</div>

