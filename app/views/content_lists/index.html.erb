<p style="color: green"><%= notice %></p>

<% content_for :title, "Content lists" %>

<h1>Content lists</h1>

<div id="content_lists">
  <% @content_lists.each do |content_list| %>
    <%= render content_list %>
    <p>
      <%= link_to "Show this content list", content_list %>
    </p>
  <% end %>
</div>

<%= link_to "New content list", new_content_list_path %>
