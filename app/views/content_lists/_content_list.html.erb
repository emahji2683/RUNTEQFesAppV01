<div class="border" id="<%= dom_id content_list %>">
  <p>
    <strong><%= t ".title" %></strong>
    <%= content_list.title %>
  </p>

  <p>
    <strong>Repeat content:</strong>
    <%= content_list.repeat_content %>
  </p>

  <p>
    <strong>Repeat times:</strong>
    <%= content_list.repeat_times %>
  </p>

  <p>
    <%= link_to "Show this content list", content_list_path(CGI.escape(content_list.title)) %>
  </p>
</div>
